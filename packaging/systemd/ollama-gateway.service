[Unit]
Description=Ollama Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ollama-gateway
Group=ollama-gateway
ExecStart=/usr/bin/ollama-gateway --config /etc/ollama-gateway/config.yaml
Restart=on-failure
RestartSec=5s
WorkingDirectory=/var/lib/ollama-gateway
StateDirectory=ollama-gateway
RuntimeDirectory=ollama-gateway
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
